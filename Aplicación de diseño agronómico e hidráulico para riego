<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AgroRiego — Diseño Agronómico e Hidráulico</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0d1117;
    --surface: #161b22;
    --surface2: #1c2230;
    --border: #30363d;
    --border2: #21262d;
    --accent: #39d353;
    --accent2: #1f6feb;
    --warn: #e3b341;
    --danger: #f85149;
    --text: #e6edf3;
    --text2: #8b949e;
    --text3: #484f58;
    --radius: 10px;
    --transition: 0.2s ease;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Outfit', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ─── TOP BAR ─── */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .logo {
    font-family: 'DM Serif Display', serif;
    font-size: 22px;
    color: var(--accent);
    letter-spacing: -0.5px;
  }
  .logo span { color: var(--text2); font-size: 13px; font-family: 'Outfit', sans-serif; margin-left: 8px; font-weight: 400; }
  .header-actions { display: flex; gap: 10px; align-items: center; }
  .toggle-mode {
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text2);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    cursor: pointer;
    font-family: 'DM Mono', monospace;
    transition: var(--transition);
  }
  .toggle-mode.active { background: var(--accent); color: #000; border-color: var(--accent); font-weight: 500; }
  .toggle-mode:hover { border-color: var(--accent); }

  /* ─── LAYOUT ─── */
  .app-shell {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: calc(100vh - 57px);
  }

  /* ─── SIDEBAR ─── */
  aside {
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 20px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .nav-section { font-size: 10px; color: var(--text3); letter-spacing: 1.2px; text-transform: uppercase; font-family: 'DM Mono', monospace; padding: 12px 8px 6px; }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13.5px;
    color: var(--text2);
    transition: var(--transition);
    border: 1px solid transparent;
  }
  .nav-item:hover { background: var(--surface2); color: var(--text); }
  .nav-item.active { background: rgba(57,211,83,0.1); color: var(--accent); border-color: rgba(57,211,83,0.2); }
  .nav-item .icon { width: 18px; text-align: center; font-size: 15px; }
  .step-badge {
    margin-left: auto;
    background: var(--surface2);
    border-radius: 10px;
    padding: 2px 7px;
    font-size: 10px;
    font-family: 'DM Mono', monospace;
    color: var(--text3);
  }
  .nav-item.active .step-badge { background: rgba(57,211,83,0.15); color: var(--accent); }
  .nav-item.completed .icon::after { content: ' ✓'; font-size: 10px; color: var(--accent); }

  /* ─── MAIN ─── */
  main {
    padding: 28px 32px;
    overflow-y: auto;
    max-height: calc(100vh - 57px);
  }

  .screen { display: none; animation: fadeIn 0.25s ease; }
  .screen.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .screen-header { margin-bottom: 24px; }
  .screen-header h2 { font-family: 'DM Serif Display', serif; font-size: 26px; font-weight: 400; color: var(--text); }
  .screen-header p { color: var(--text2); font-size: 13.5px; margin-top: 4px; }

  /* ─── CARDS & GRID ─── */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    margin-bottom: 16px;
  }
  .card-title { font-size: 12px; font-family: 'DM Mono', monospace; color: var(--accent); letter-spacing: 0.8px; text-transform: uppercase; margin-bottom: 16px; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
  .col-span-2 { grid-column: span 2; }

  /* ─── FORM ELEMENTS ─── */
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 12px; color: var(--text2); font-weight: 500; }
  .field label .req { color: var(--danger); margin-left: 2px; }
  .field label .opt { color: var(--text3); font-size: 11px; margin-left: 4px; }

  input[type="text"], input[type="number"], select, textarea {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 7px;
    padding: 9px 12px;
    font-size: 13.5px;
    font-family: 'Outfit', sans-serif;
    transition: var(--transition);
    width: 100%;
    outline: none;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(57,211,83,0.1); }
  input.error { border-color: var(--danger); }
  select option { background: var(--bg); }
  .field-unit {
    display: flex; gap: 0;
  }
  .field-unit input { border-radius: 7px 0 0 7px; }
  .field-unit select { border-radius: 0 7px 7px 0; border-left: none; width: auto; min-width: 80px; color: var(--text2); }
  .field-hint { font-size: 11px; color: var(--text3); }
  .field-error { font-size: 11px; color: var(--danger); display: none; }
  .field-error.show { display: block; }

  /* ─── BUTTONS ─── */
  .btn {
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 13.5px;
    font-family: 'Outfit', sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .btn-primary { background: var(--accent); color: #000; }
  .btn-primary:hover { background: #4ade80; }
  .btn-secondary { background: transparent; border-color: var(--border); color: var(--text2); }
  .btn-secondary:hover { border-color: var(--text2); color: var(--text); }
  .btn-ghost { background: transparent; color: var(--text2); }
  .btn-ghost:hover { color: var(--text); background: var(--surface2); }
  .btn-sm { padding: 6px 12px; font-size: 12px; }
  .btn-danger { background: rgba(248,81,73,0.1); border-color: var(--danger); color: var(--danger); }

  .actions-bar { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border2); }

  /* ─── RESULTS ─── */
  .result-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .result-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    position: relative;
    overflow: hidden;
  }
  .result-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); }
  .result-card.blue::before { background: var(--accent2); }
  .result-card.warn::before { background: var(--warn); }
  .result-card .r-label { font-size: 11px; color: var(--text2); font-family: 'DM Mono', monospace; margin-bottom: 6px; }
  .result-card .r-value { font-size: 26px; font-family: 'DM Serif Display', serif; color: var(--text); line-height: 1; }
  .result-card .r-unit { font-size: 12px; color: var(--text2); margin-top: 3px; }
  .result-card .r-formula { font-size: 10px; color: var(--text3); font-family: 'DM Mono', monospace; margin-top: 8px; }

  .highlight-box {
    background: rgba(57,211,83,0.05);
    border: 1px solid rgba(57,211,83,0.2);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-bottom: 14px;
  }
  .highlight-box h3 { font-size: 13px; color: var(--accent); font-family: 'DM Mono', monospace; margin-bottom: 10px; letter-spacing: 0.5px; }
  .highlight-row { display: flex; justify-content: space-between; align-items: baseline; padding: 5px 0; border-bottom: 1px solid rgba(57,211,83,0.1); }
  .highlight-row:last-child { border-bottom: none; }
  .highlight-row .hl-label { font-size: 13px; color: var(--text2); }
  .highlight-row .hl-value { font-size: 15px; font-weight: 600; color: var(--text); font-family: 'DM Mono', monospace; }

  /* ─── ALERTS ─── */
  .alerts-container { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
  .alert {
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .alert-warn { background: rgba(227,179,65,0.1); border: 1px solid rgba(227,179,65,0.3); color: var(--warn); }
  .alert-danger { background: rgba(248,81,73,0.1); border: 1px solid rgba(248,81,73,0.3); color: var(--danger); }
  .alert-info { background: rgba(31,111,235,0.1); border: 1px solid rgba(31,111,235,0.3); color: #58a6ff; }
  .alert-ok { background: rgba(57,211,83,0.08); border: 1px solid rgba(57,211,83,0.2); color: var(--accent); }

  /* ─── ASSUMPTIONS BOX ─── */
  .assumptions {
    background: var(--surface2);
    border: 1px solid var(--border2);
    border-radius: var(--radius);
    padding: 14px 18px;
    margin-top: 14px;
  }
  .assumptions h4 { font-size: 11px; color: var(--text3); font-family: 'DM Mono', monospace; letter-spacing: 0.8px; text-transform: uppercase; margin-bottom: 10px; }
  .assumption-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .assumption-tag {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 3px 10px;
    font-size: 11px;
    font-family: 'DM Mono', monospace;
    color: var(--text2);
  }
  .assumption-tag span { color: var(--text); }

  /* ─── CATALOG TABLE ─── */
  .catalog-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .catalog-table th { background: var(--surface2); color: var(--text2); font-size: 11px; font-family: 'DM Mono', monospace; letter-spacing: 0.5px; text-transform: uppercase; padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--border); }
  .catalog-table td { padding: 8px 12px; border-bottom: 1px solid var(--border2); color: var(--text); }
  .catalog-table tr:hover td { background: var(--surface2); }
  .catalog-table tr.selected td { background: rgba(57,211,83,0.07); }
  .catalog-table tr { cursor: pointer; }
  .num { font-family: 'DM Mono', monospace; color: var(--text2); }

  /* ─── TABS ─── */
  .tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); margin-bottom: 20px; }
  .tab { padding: 9px 18px; font-size: 13px; cursor: pointer; color: var(--text2); border-bottom: 2px solid transparent; margin-bottom: -1px; transition: var(--transition); }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); }

  /* ─── PROJECTS LIST ─── */
  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 10px;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .project-card:hover { border-color: var(--accent); background: var(--surface2); }
  .project-card .p-name { font-size: 15px; font-weight: 500; }
  .project-card .p-meta { font-size: 12px; color: var(--text2); margin-top: 3px; font-family: 'DM Mono', monospace; }
  .project-card .p-actions { display: flex; gap: 8px; }

  .empty-state { text-align: center; padding: 60px 20px; color: var(--text3); }
  .empty-state .icon { font-size: 48px; margin-bottom: 16px; }
  .empty-state p { font-size: 14px; }

  /* ─── SHARE BOX ─── */
  .share-box { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); display: none; align-items: center; justify-content: center; z-index: 200; }
  .share-box.open { display: flex; }
  .share-box-inner { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; width: 500px; max-width: 95vw; max-height: 80vh; overflow-y: auto; }
  .share-box-inner textarea { height: 300px; font-family: 'DM Mono', monospace; font-size: 12px; color: var(--text2); resize: none; }

  /* ─── HISTORY ─── */
  .history-item { background: var(--surface2); border: 1px solid var(--border2); border-radius: 8px; padding: 12px 14px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
  .history-item .h-title { font-size: 13px; }
  .history-item .h-meta { font-size: 11px; color: var(--text2); font-family: 'DM Mono', monospace; margin-top: 2px; }
  .history-item .h-restore { font-size: 12px; color: var(--accent); cursor: pointer; }

  /* ─── RADIO PILLS ─── */
  .pill-group { display: flex; gap: 8px; flex-wrap: wrap; }
  .pill {
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 20px;
    font-size: 13px;
    cursor: pointer;
    color: var(--text2);
    transition: var(--transition);
    background: var(--bg);
  }
  .pill:hover { border-color: var(--text2); color: var(--text); }
  .pill.selected { border-color: var(--accent); color: var(--accent); background: rgba(57,211,83,0.08); }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 768px) {
    .app-shell { grid-template-columns: 1fr; }
    aside { display: none; }
    main { padding: 16px; }
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
  }

  /* ─── SCROLLBAR ─── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

  .divider { height: 1px; background: var(--border2); margin: 20px 0; }
  
  .tag { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-family: 'DM Mono', monospace; }
  .tag-green { background: rgba(57,211,83,0.1); color: var(--accent); }
  .tag-blue { background: rgba(31,111,235,0.1); color: #58a6ff; }
  .tag-warn { background: rgba(227,179,65,0.1); color: var(--warn); }

  .kc-display { display: inline-flex; align-items: center; gap: 6px; }
  .kc-display .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
</style>
</head>
<body>

<header>
  <div class="logo">AgroRiego <span>Diseño Agronómico · Hidráulico</span></div>
  <div class="header-actions">
    <button class="toggle-mode" id="modeToggle" onclick="toggleTechMode()">🔬 Modo técnico</button>
    <button class="btn btn-sm btn-secondary" onclick="showShare()">📤 Compartir</button>
  </div>
</header>

<div class="app-shell">
  <aside>
    <div class="nav-section">Proyecto</div>
    <div class="nav-item active" id="nav-home" onclick="showScreen('home')">
      <span class="icon">🏠</span> Inicio
    </div>

    <div class="nav-section">Cálculo</div>
    <div class="nav-item" id="nav-parcela" onclick="showScreen('parcela')">
      <span class="icon">📍</span> A. Parcela <span class="step-badge">1</span>
    </div>
    <div class="nav-item" id="nav-cultivo" onclick="showScreen('cultivo')">
      <span class="icon">🌱</span> B. Cultivo <span class="step-badge">2</span>
    </div>
    <div class="nav-item" id="nav-clima" onclick="showScreen('clima')">
      <span class="icon">🌤️</span> C. Clima <span class="step-badge">3</span>
    </div>
    <div class="nav-item" id="nav-suelo" onclick="showScreen('suelo')">
      <span class="icon">🪨</span> D. Suelo <span class="step-badge">4</span>
    </div>
    <div class="nav-item" id="nav-riego" onclick="showScreen('riego')">
      <span class="icon">💧</span> E. Riego <span class="step-badge">5</span>
    </div>
    <div class="nav-item" id="nav-resultados" onclick="showScreen('resultados')">
      <span class="icon">📊</span> F. Resultados <span class="step-badge">6</span>
    </div>
    <div class="nav-item" id="nav-hidraulica" onclick="showScreen('hidraulica')">
      <span class="icon">⚡</span> G. Hidráulica <span class="step-badge">7</span>
    </div>

    <div class="nav-section" style="margin-top: auto;">Datos</div>
    <div class="nav-item" id="nav-catalogos" onclick="showScreen('catalogos')">
      <span class="icon">📚</span> Catálogos
    </div>
    <div class="nav-item" id="nav-historial" onclick="showScreen('historial')">
      <span class="icon">📋</span> Historial
    </div>
  </aside>

  <main>

    <!-- ══════════════════ INICIO ══════════════════ -->
    <div class="screen active" id="screen-home">
      <div class="screen-header">
        <h2>Proyectos</h2>
        <p>Gestiona tus fincas y campañas de riego</p>
      </div>
      <div style="display:flex; gap:10px; margin-bottom:20px;">
        <button class="btn btn-primary" onclick="newProject()">+ Nuevo proyecto</button>
        <button class="btn btn-secondary" onclick="showScreen('parcela')">⚡ Cálculo rápido</button>
      </div>
      <div id="projects-list"></div>
    </div>

    <!-- ══════════════════ A: PARCELA ══════════════════ -->
    <div class="screen" id="screen-parcela">
      <div class="screen-header">
        <h2>A. Parcela</h2>
        <p>Identificación y características básicas de la parcela</p>
      </div>
      <div class="card">
        <div class="card-title">Identificación</div>
        <div class="grid-2">
          <div class="field">
            <label>ID / Nombre <span class="req">*</span></label>
            <input type="text" id="parcel_id" placeholder="Ej: Parcela-01 o Lote Norte" oninput="autoSave()">
            <div class="field-error" id="err_parcel_id">El nombre no puede estar vacío</div>
          </div>
          <div class="field">
            <label>Nombre descriptivo <span class="opt">(opcional)</span></label>
            <input type="text" id="parcel_name" placeholder="Ej: Tomate sector A" oninput="autoSave()">
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Área</div>
        <div class="grid-2">
          <div class="field">
            <label>Área <span class="req">*</span></label>
            <div class="field-unit">
              <input type="number" id="area_value" placeholder="0" min="0" step="0.01" oninput="updateAreaCalc(); autoSave()">
              <select id="area_unit" onchange="updateAreaCalc(); autoSave()">
                <option value="ha">ha</option>
                <option value="m2">m²</option>
              </select>
            </div>
            <div class="field-error" id="err_area">El área debe ser mayor a 0</div>
          </div>
          <div class="field">
            <label>Conversión automática</label>
            <div style="background: var(--bg); border: 1px solid var(--border2); border-radius:7px; padding: 9px 12px; font-family: 'DM Mono', monospace; font-size:13px; color: var(--text2);" id="area_converted">—</div>
          </div>
        </div>
      </div>

      <div class="card" id="techCard-parcela" style="display:none;">
        <div class="card-title">Datos adicionales <span class="tag tag-blue">Modo técnico</span></div>
        <div class="grid-3">
          <div class="field">
            <label>Pendiente <span class="opt">(%)</span></label>
            <input type="number" id="slope_pct" placeholder="0–60" min="0" max="60" oninput="autoSave()">
            <div class="field-hint">Alerta si &gt; 20%</div>
          </div>
          <div class="field">
            <label>Altitud <span class="opt">(m)</span></label>
            <input type="number" id="elevation_m" placeholder="0–5000" min="0" max="5000" oninput="autoSave()">
          </div>
          <div class="field">
            <label>Observaciones</label>
            <input type="text" id="notes_parcela" placeholder="Notas..." oninput="autoSave()">
          </div>
        </div>
      </div>

      <div class="actions-bar">
        <button class="btn btn-secondary" onclick="showScreen('home')">← Inicio</button>
        <button class="btn btn-primary" onclick="validateAndGo('parcela','cultivo')">Continuar → Cultivo</button>
      </div>
    </div>

    <!-- ══════════════════ B: CULTIVO ══════════════════ -->
    <div class="screen" id="screen-cultivo">
      <div class="screen-header">
        <h2>B. Cultivo y Etapa</h2>
        <p>Coeficiente de cultivo, etapa fenológica y raíz</p>
      </div>

      <div class="card">
        <div class="card-title">Selección de cultivo</div>
        <div class="grid-2">
          <div class="field">
            <label>Cultivo <span class="req">*</span></label>
            <select id="crop_name" onchange="loadCropDefaults(); autoSave()">
              <option value="">— Selecciona cultivo —</option>
              <option value="Papa">Papa</option>
              <option value="Maíz (grano)">Maíz (grano)</option>
              <option value="Lechuga">Lechuga</option>
              <option value="Tomate (campo)">Tomate (campo)</option>
              <option value="Cebolla">Cebolla</option>
              <option value="Zanahoria">Zanahoria</option>
              <option value="Brócoli">Brócoli</option>
              <option value="Fréjol (arbustivo)">Fréjol (arbustivo)</option>
              <option value="Alfalfa (corte)">Alfalfa (corte)</option>
