<script>
// ══════════════════════════════════════════════════════
// DATA CATALOGS
// ══════════════════════════════════════════════════════
const CROPS = {
  'Papa':              { ini:0.50, des:0.85, med:1.15, fin:0.75, zr:0.60, p:0.35 },
  'Maíz (grano)':     { ini:0.40, des:0.80, med:1.15, fin:0.70, zr:1.20, p:0.55 },
  'Lechuga':          { ini:0.70, des:0.90, med:1.05, fin:0.95, zr:0.30, p:0.30 },
  'Tomate (campo)':   { ini:0.60, des:0.90, med:1.15, fin:0.80, zr:0.80, p:0.40 },
  'Cebolla':          { ini:0.70, des:0.90, med:1.05, fin:0.80, zr:0.40, p:0.30 },
  'Zanahoria':        { ini:0.70, des:0.90, med:1.05, fin:0.85, zr:0.50, p:0.35 },
  'Brócoli':          { ini:0.70, des:0.95, med:1.05, fin:0.95, zr:0.50, p:0.35 },
  'Fréjol (arbustivo)':{ ini:0.40, des:0.80, med:1.10, fin:0.70, zr:0.90, p:0.45 },
  'Alfalfa (corte)':  { ini:null, des:null, med:1.05, fin:null, zr:1.50, p:0.55 },
  'Pasto (raigrás/mezcla)':{ ini:0.90, des:1.00, med:1.05, fin:0.95, zr:0.60, p:0.50 },
  'Fresa':            { ini:0.50, des:0.75, med:0.95, fin:0.80, zr:0.30, p:0.30 },
};

const SOILS = {
  'Arenoso':           { taw:80,  tfc:0.15, twp:0.07 },
  'Franco arenoso':    { taw:110, tfc:0.20, twp:0.10 },
  'Franco':            { taw:140, tfc:0.27, twp:0.13 },
  'Franco limoso':     { taw:160, tfc:0.32, twp:0.16 },
  'Franco arcilloso':  { taw:170, tfc:0.34, twp:0.17 },
  'Arcilloso':         { taw:150, tfc:0.38, twp:0.22 },
};

const METHODS = {
  'goteo':     { name:'Goteo',         ea:0.90, range:'0.85–0.95' },
  'aspersion': { name:'Aspersión',     ea:0.75, range:'0.70–0.85' },
  'micro':     { name:'Microaspersión',ea:0.85, range:'0.75–0.90' },
  'surcos':    { name:'Surcos',        ea:0.55, range:'0.40–0.70' },
};

// ══════════════════════════════════════════════════════
// STATE
// ══════════════════════════════════════════════════════
let state = {
  techMode: false,
  soilMode: 'rapido',
  selectedStage: 'med',
  selectedMethod: 'goteo',
  periodMode: 'day',
  projects: [],
  history: [],
  currentProject: null,
  calculated: false,
  results: {},
};

// ══════════════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════════════
window.onload = () => {
  loadStorage();
  renderProjects();
  renderHistory();
  renderCatalogs();
  // Set today's date
  const today = new Date().toISOString().split('T')[0];
  document.getElementById('calc_date').value = today;
  // Set default method
  selectMethod('goteo');
  // Set default sector
  document.getElementById('sectors_n').value = '1';
};

function loadStorage() {
  try {
    const saved = localStorage.getItem('agroRiegoState');
    if (saved) {
      const parsed = JSON.parse(saved);
      state.projects = parsed.projects || [];
      state.history = parsed.history || [];
    }
  } catch(e) {}
}

function saveStorage() {
  try {
    localStorage.setItem('agroRiegoState', JSON.stringify({
      projects: state.projects,
      history: state.history
    }));
  } catch(e) {}
}

function autoSave() {
  // minimal autosave trigger
}

// ══════════════════════════════════════════════════════
// NAVIGATION
// ══════════════════════════════════════════════════════
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('screen-' + id).classList.add('active');
  const nav = document.getElementById('nav-' + id);
  if (nav) nav.classList.add('active');
  if (id === 'resultados') calcResults();
  if (id === 'historial') renderHistory();
}

// ══════════════════════════════════════════════════════
// TOGGLES
// ══════════════════════════════════════════════════════
function toggleTechMode() {
  state.techMode = !state.techMode;
  const btn = document.getElementById('modeToggle');
  btn.classList.toggle('active', state.techMode);
  btn.textContent = state.techMode ? '🔬 Modo técnico ON' : '🔬 Modo técnico';
  document.querySelectorAll('[id^="techCard-"]').forEach(el => {
    el.style.display = state.techMode ? 'block' : 'none';
  });
}

function selectStage(stage) {
  state.selectedStage = stage;
  document.querySelectorAll('#stage-pills .pill').forEach(p => p.classList.remove('selected'));
  document.querySelector(`[data-stage="${stage}"]`).classList.add('selected');
  loadCropDefaults();
}

function selectMethod(method) {
  state.selectedMethod = method;
  document.querySelectorAll('#method-pills .pill').forEach(p => p.classList.remove('selected'));
  document.querySelector(`[data-method="${method}"]`).classList.add('selected');
  const m = METHODS[method];
  document.getElementById('ea_value').value = m.ea;
  document.getElementById('ea_hint').textContent = `Default ${m.name}: ${m.ea} | Rango: ${m.range}`;
  document.getElementById('ea_range_text').textContent = m.range;
}

function selectPeriod(p) {
  state.periodMode = p;
  document.getElementById('period-day').classList.toggle('selected', p === 'day');
  document.getElementById('period-week').classList.toggle('selected', p === 'week');
  const unit = p === 'day' ? 'mm/d' : 'mm/sem';
  document.getElementById('eto_unit_opt').textContent = unit;
  document.getElementById('pe_unit_opt').textContent = unit;
  updateEtoCalc();
}

function soilTab(tab) {
  state.soilMode = tab;
  document.getElementById('tab-rapido').classList.toggle('active', tab === 'rapido');
  document.getElementById('tab-tecnico').classList.toggle('active', tab === 'tecnico');
  document.getElementById('suelo-rapido').style.display = tab === 'rapido' ? 'block' : 'none';
  document.getElementById('suelo-tecnico').style.display = tab === 'tecnico' ? 'block' : 'none';
}

function catTab(tab) {
  ['crops','soils','methods'].forEach(t => {
    document.getElementById('cat-' + t).style.display = t === tab ? 'block' : 'none';
    document.getElementById('cat-tab-' + t).classList.toggle('active', t === tab);
  });
}

// ══════════════════════════════════════════════════════
// CATALOG DEFAULTS
// ══════════════════════════════════════════════════════
function loadCropDefaults() {
  const crop = document.getElementById('crop_name').value;
  if (!crop || crop === 'Personalizado') return;
  const data = CROPS[crop];
  if (!data) return;
  const stage = state.selectedStage;
  const kc = data[stage === 'ini' ? 'ini' : stage === 'des' ? 'des' : stage === 'fin' ? 'fin' : 'med'];
  document.getElementById('kc_value').value = kc !== null ? kc.toFixed(2) : '';
  document.getElementById('zr_m').value = data.zr.toFixed(2);
  document.getElementById('p_value').value = data.p.toFixed(2);
  document.getElementById('kc_hint').textContent = `Kc ${stage} para ${crop} (FAO-56)`;
  document.getElementById('zr_reminder').textContent = data.zr.toFixed(2);
  // Set zeff to zr as default
  if (!document.getElementById('z_eff_m').value) document.getElementById('z_eff_m').value = data.zr.toFixed(2);
  calcTAW();
}

function loadSoilDefaults() {
  const tex = document.getElementById('soil_texture').value;
  if (!tex) return;
  const data = SOILS[tex];
  calcTAW();
}

// ══════════════════════════════════════════════════════
// CALCULATIONS
// ══════════════════════════════════════════════════════
function updateAreaCalc() {
  const val = parseFloat(document.getElementById('area_value').value);
  const unit = document.getElementById('area_unit').value;
  if (!val || val <= 0) { document.getElementById('area_converted').textContent = '—'; return; }
  if (unit === 'ha') {
    document.getElementById('area_converted').textContent = `${(val * 10000).toLocaleString('es')} m²`;
  } else {
    document.getElementById('area_converted').textContent = `${(val / 10000).toFixed(4)} ha`;
  }
}

function getAreaM2() {
  const val = parseFloat(document.getElementById('area_value').value) || 0;
  const unit = document.getElementById('area_unit').value;
  return unit === 'ha' ? val * 10000 : val;
}

function updateEtoCalc() {
  const val = parseFloat(document.getElementById('eto_value').value) || 0;
  const etoNorm = state.periodMode === 'week' ? (val / 7).toFixed(2) : val.toFixed(2);
  document.getElementById('eto_normalized').textContent = `${etoNorm} mm/d`;
}

function getEtoDay() {
  const val = parseFloat(document.getElementById('eto_value').value) || 0;
  return state.periodMode === 'week' ? val / 7 : val;
}

function getPeDay() {
  const val = parseFloat(document.getElementById('pe_value').value) || 0;
  return state.periodMode === 'week' ? val / 7 : val;
}

function calcTAW() {
  const tex = document.getElementById('soil_texture').value;
  const zeff = parseFloat(document.getElementById('z_eff_m').value) || 0;
  const p = parseFloat(document.getElementById('p_value').value) || 0.35;
  if (!tex || zeff <= 0) { document.getElementById('taw_preview').style.display = 'none'; return; }
  const soil = SOILS[tex];
  const taw = soil.taw * zeff; // approx using mm/m × z
  const raw = p * taw;
  document.getElementById('taw_preview').style.display = 'block';
  document.getElementById('taw_val').textContent = taw.toFixed(1);
  document.getElementById('raw_val').textContent = raw.toFixed(1);
  document.getElementById('tfc_val').textContent = soil.tfc.toFixed(2);
  document.getElementById('twp_val').textContent = soil.twp.toFixed(2);
}

function calcTAWtech() {
  const tfc = parseFloat(document.getElementById('theta_fc').value) || 0;
  const twp = parseFloat(document.getElementById('theta_wp').value) || 0;
  const zeff = parseFloat(document.getElementById('z_eff_m_tech').value) || 0;
  const p = parseFloat(document.getElementById('p_value').value) || 0.35;
  if (tfc <= 0 || twp <= 0 || zeff <= 0) { document.getElementById('taw_preview_tech').style.display = 'none'; return; }
  const taw = 1000 * (tfc - twp) * zeff;
  const raw = p * taw;
  document.getElementById('taw_preview_tech').style.display = taw > 0 ? 'block' : 'none';
  document.getElementById('taw_val_tech').textContent = taw.toFixed(1);
  document.getElementById('raw_val_tech').textContent = raw.toFixed(1);
}

function getTAWRAW() {
  let taw = 0, raw = 0;
  const p = parseFloat(document.getElementById('p_value').value) || 0.35;
  if (state.soilMode === 'rapido') {
    const tex = document.getElementById('soil_texture').value;
    const zeff = parseFloat(document.getElementById('z_eff_m').value) || 0;
    if (tex && zeff > 0) {
      taw = SOILS[tex].taw * zeff;
      raw = p * taw;
    }
  } else {
    const tfc = parseFloat(document.getElementById('theta_fc').value) || 0;
    const twp = parseFloat(document.getElementById('theta_wp').value) || 0;
    const zeff = parseFloat(document.getElementById('z_eff_m_tech').value) || 0;
    if (tfc > twp && zeff > 0) {
      taw = 1000 * (tfc - twp) * zeff;
      raw = p * taw;
    }
  }
  return { taw, raw };
}

function calcQsector() {
  const q = parseFloat(document.getElementById('q_total_value').value) || 0;
  const unit = document.getElementById('q_total_unit').value;
  const sec = parseInt(document.getElementById('sectors_n').value) || 1;
  const qM3h = unit === 'Lps' ? q * 3.6 : q;
  const qSec = sec > 0 ? qM3h / sec : 0;
  document.getElementById('q_sector_display').textContent = q > 0 ? `${qSec.toFixed(2)} m³/h por sector` : '—';
}

function getQm3h() {
  const q = parseFloat(document.getElementById('q_total_value').value) || 0;
  const unit = document.getElementById('q_total_unit').value;
  return unit === 'Lps' ? q * 3.6 : q;
}

function calcResults() {
  const kc = parseFloat(document.getElementById('kc_value').value) || 0;
  const eto = getEtoDay();
  const pe = getPeDay();
  const ea = parseFloat(document.getElementById('ea_value').value) || 0.9;
  const { taw, raw } = getTAWRAW();
  const areaM2 = getAreaM2();
  const qTotal = getQm3h();
  const sectors = parseInt(document.getElementById('sectors_n').value) || 1;
  const parcel = document.getElementById('parcel_id').value || '—';

  // Core calculations
  const etc = kc * eto;
  const nir = Math.max(0, etc - pe);
  const gir = ea > 0 ? nir / ea : 0;
  const freq = etc > 0 ? raw / etc : 0;
  const volNir = nir * areaM2 / 1000;
  const volGir = gir * areaM2 / 1000;
  const qSector = sectors > 0 ? qTotal / sectors : qTotal;
  const timeTot = qTotal > 0 ? volGir / qTotal : 0;
  const timeSec = qSector > 0 ? (volGir / sectors) / qSector : 0;

  // Store
  state.results = { kc, eto, pe, ea, taw, raw, areaM2, qTotal, sectors, parcel, etc, nir, gir, freq, volGir, timeTot, timeSec };

  // Update UI
  document.getElementById('result_subtitle').textContent = `Parcela: ${parcel} · Fecha: ${document.getElementById('calc_date').value || 'N/A'}`;

  const fmtN = (n, d=1) => isNaN(n) || !isFinite(n) ? '—' : n.toFixed(d);

  document.getElementById('r_gir').textContent = `${fmtN(gir)} mm/d`;
  document.getElementById('r_vol').textContent = `${fmtN(volGir, 2)} m³`;
  document.getElementById('r_time_total').textContent = `${fmtN(timeTot, 2)} h`;
  document.getElementById('r_time_sector').textContent = `${fmtN(timeSec, 2)} h`;
  document.getElementById('r_freq').textContent = `cada ${fmtN(freq, 1)} días`;

  document.getElementById('r_etc').textContent = fmtN(etc);
  document.getElementById('r_nir').textContent = fmtN(nir);
  document.getElementById('r_gir2').textContent = fmtN(gir);
  document.getElementById('r_taw').textContent = fmtN(taw, 1);
  document.getElementById('r_raw').textContent = fmtN(raw, 1);
  document.getElementById('r_vol2').textContent = fmtN(volGir, 2);

  // Alerts
  const alerts = [];
  if (eto === 0 && kc > 0) alerts.push({ type:'warn', msg:'⚠️ ET₀ = 0 pero Kc > 0 — revisa el dato climático.' });
  if (gir > raw && raw > 0) alerts.push({ type:'danger', msg:'🚨 Lámina bruta por evento supera RAW — riesgo de percolación profunda.' });
  if (freq < 1 && freq > 0) alerts.push({ type:'warn', msg:'⚡ Frecuencia < 1 día — considera dividir en 2 eventos diarios.' });
  if (kc > 1.4) alerts.push({ type:'warn', msg:`⚠️ Kc = ${kc} está fuera del rango típico (0.2–1.4). Verifica.` });
  if (ea < 0.5) alerts.push({ type:'warn', msg:`⚠️ Eficiencia Ea = ${ea} parece baja. Revisa el método de riego.` });
  if (timeTot > 24) alerts.push({ type:'warn', msg:`⏰ Tiempo total de riego: ${fmtN(timeTot,1)} h — puede superar un día. Considera más caudal o más sectores.` });
  if (gir > 0 && taw > 0 && nir === 0 && pe > 0) alerts.push({ type:'info', msg:'ℹ️ NIR = 0 — la lluvia efectiva cubre el requerimiento del cultivo. No se necesita riego hoy.' });

  const cont = document.getElementById('alerts_container');
  cont.innerHTML = alerts.length ? alerts.map(a => `<div class="alert alert-${a.type}">${a.msg}</div>`).join('') :
    `<div class="alert alert-ok">✅ Sin alertas. Los parámetros están dentro de rangos normales.</div>`;

  // Assumptions
  const crop = document.getElementById('crop_name').value || 'N/A';
  const stage = state.selectedStage;
  const method = METHODS[state.selectedMethod]?.name || 'N/A';
  document.getElementById('assumptions_row').innerHTML = [
    `ET₀: <span>${fmtN(eto)} mm/d</span>`,
    `Kc: <span>${kc} (${crop}, ${stage})</span>`,
    `Pe: <span>${fmtN(pe)} mm/d</span>`,
    `Ea: <span>${ea} (${method})</span>`,
    `TAW: <span>${fmtN(taw,1)} mm</span>`,
    `RAW: <span>${fmtN(raw,1)} mm</span>`,
    `Área: <span>${fmtN(areaM2/10000,4)} ha</span>`,
    `Sectores: <span>${sectors}</span>`,
  ].map(t => `<span class="assumption-tag">${t}</span>`).join('');

  state.calculated = true;
}

function calcHydraulic() {
  const pressure = parseFloat(document.getElementById('pressure_in_bar').value) || 0;
  const diam = parseFloat(document.getElementById('main_diam_mm').value) || 0;
  const deltaZ = parseFloat(document.getElementById('delta_z_m').value) || 0;
  const qM3h = getQm3h();
  const qM3s = qM3h / 3600;

  // Velocity check
  let vel = null;
  if (diam > 0 && qM3h > 0) {
    const r = diam / 2000; // m
    const area = Math.PI * r * r;
    vel = qM3s / area;
  }

  const alerts = [];
  if (vel !== null) {
    if (vel > 2.0) alerts.push({ type:'danger', msg:`🚨 Velocidad ${vel.toFixed(2)} m/s supera 2.0 m/s — riesgo de golpe de ariete. Usar diámetro mayor.` });
    else if (vel > 1.5) alerts.push({ type:'warn', msg:`⚠️ Velocidad ${vel.toFixed(2)} m/s supera 1.5 m/s — zona de precaución.` });
    else alerts.push({ type:'ok', msg:`✅ Velocidad ${vel.toFixed(2)} m/s — dentro del rango aceptable (< 1.5 m/s).` });
  }
  if (pressure > 0 && pressure < 1.0 && (state.selectedMethod === 'goteo' || state.selectedMethod === 'micro')) {
    alerts.push({ type:'warn', msg:`⚠️ Presión disponible ${pressure} bar podría no ser suficiente para goteo/microaspersión (mín. ~1.0–1.5 bar).` });
  }
  if (Math.abs(deltaZ) > 30) alerts.push({ type:'warn', msg:`⚠️ Desnivel grande (${deltaZ > 0 ? '+' : ''}${deltaZ} m) — considerar válvulas reductoras de presión o regulación.` });

  const cont = document.getElementById('hydro_alerts');
  cont.innerHTML = alerts.length ? alerts.map(a => `<div class="alert alert-${a.type}">${a.msg}</div>`).join('') : '';

  document.getElementById('h_q').textContent = qM3h.toFixed(2);
  document.getElementById('h_vel').textContent = vel !== null ? vel.toFixed(2) : '—';
  document.getElementById('h_pres').textContent = pressure > 0 ? `${pressure} bar / ${(pressure * 10.2).toFixed(1)} mca` : '—';
}

// ══════════════════════════════════════════════════════
// VALIDATION
// ══════════════════════════════════════════════════════
const validators = {
  parcela: () => {
    let ok = true;
    const pid = document.getElementById('parcel_id').value.trim();
    const area = parseFloat(document.getElementById('area_value').value);
    showErr('err_parcel_id', !pid);
    showErr('err_area', !area || area <= 0);
    if (!pid || !area || area <= 0) ok = false;
    return ok;
  },
  cultivo: () => {
    let ok = true;
    const crop = document.getElementById('crop_name').value;
    const kc = parseFloat(document.getElementById('kc_value').value);
    const zr = parseFloat(document.getElementById('zr_m').value);
    const p = parseFloat(document.getElementById('p_value').value);
    showErr('err_crop', !crop);
    showErr('err_kc', !kc || kc < 0.1 || kc > 1.6);
    showErr('err_zr', !zr || zr <= 0);
    showErr('err_p', !p || p < 0.1 || p > 0.8);
    if (!crop || !kc || kc < 0.1 || !zr || zr <= 0 || !p) ok = false;
    return ok;
  },
  clima: () => {
    const eto = parseFloat(document.getElementById('eto_value').value);
    showErr('err_eto', eto < 0 || isNaN(eto));
    return eto >= 0 && !isNaN(eto);
  },
  suelo: () => {
    if (state.soilMode === 'rapido') {
      const tex = document.getElementById('soil_texture').value;
      const zeff = parseFloat(document.getElementById('z_eff_m').value);
      showErr('err_soil', !tex);
      showErr('err_zeff', !zeff || zeff <= 0);
      return tex && zeff > 0;
    } else {
      const tfc = parseFloat(document.getElementById('theta_fc').value);
      const twp = parseFloat(document.getElementById('theta_wp').value);
      showErr('err_tfc', tfc <= twp);
      return tfc > twp;
    }
  },
  riego: () => {
    const ea = parseFloat(document.getElementById('ea_value').value);
    const q = parseFloat(document.getElementById('q_total_value').value);
    const sec = parseInt(document.getElementById('sectors_n').value);
    showErr('err_ea', !ea || ea < 0.3 || ea > 1);
    showErr('err_q', !q || q <= 0);
    showErr('err_sectors', !sec || sec < 1);
    return ea >= 0.3 && q > 0 && sec >= 1;
  }
};

function showErr(id, show) {
  const el = document.getElementById(id);
  if (el) el.classList.toggle('show', show);
}

function validateAndGo(from, to) {
  const v = validators[from];
  if (!v || v()) showScreen(to);
}

// ══════════════════════════════════════════════════════
// PROJECTS & HISTORY
// ══════════════════════════════════════════════════════
function newProject() {
  const name = prompt('Nombre del proyecto / finca:');
  if (!name) return;
  state.projects.push({ id: Date.now(), name, parcels: [], created: new Date().toLocaleDateString('es') });
  saveStorage();
  renderProjects();
}

function renderProjects() {
  const el = document.getElementById('projects-list');
  if (!state.projects.length) {
    el.innerHTML = `<div class="empty-state"><div class="icon">🌱</div><p>No tienes proyectos aún. Crea uno o haz un cálculo rápido.</p></div>`;
    return;
  }
  el.innerHTML = state.projects.map(p => `
    <div class="project-card" onclick="openProject(${p.id})">
      <div><div class="p-name">${p.name}</div><div class="p-meta">Creado: ${p.created} · ${p.parcels?.length||0} parcelas</div></div>
      <div class="p-actions">
        <button class="btn btn-sm btn-ghost" onclick="event.stopPropagation(); deleteProject(${p.id})">🗑️</button>
        <button class="btn btn-sm btn-secondary">Abrir →</button>
      </div>
    </div>`).join('');
}

function openProject(id) {
  state.currentProject = id;
  showScreen('parcela');
}

function deleteProject(id) {
  if (confirm('¿Eliminar proyecto?')) {
    state.projects = state.projects.filter(p => p.id !== id);
    saveStorage();
    renderProjects();
  }
}

function saveCalc() {
  if (!state.calculated) { alert('Primero calcula los resultados en la pantalla F.'); return; }
  const r = state.results;
  const entry = {
    id: Date.now(),
    date: new Date().toLocaleString('es'),
    parcel: r.parcel,
    crop: document.getElementById('crop_name').value,
    etc: r.etc?.toFixed(2),
    gir: r.gir?.toFixed(2),
    vol: r.volGir?.toFixed(2),
    time: r.timeTot?.toFixed(2),
    freq: r.freq?.toFixed(1),
  };
  state.history.unshift(entry);
  if (state.history.length > 10) state.history.pop();
  saveStorage();
  alert('✅ Cálculo guardado en historial');
}

function renderHistory() {
  const el = document.getElementById('history_list');
  if (!state.history.length) {
    el.innerHTML = `<div class="empty-state"><div class="icon">📋</div><p>No hay cálculos guardados aún.</p></div>`;
    return;
  }
  el.innerHTML = state.history.map(h => `
    <div class="history-item">
      <div>
        <div class="h-title">${h.parcel} — ${h.crop}</div>
        <div class="h-meta">${h.date} · ETc=${h.etc} mm/d · GIR=${h.gir} mm/d · Vol=${h.vol} m³ · ${h.time}h · cada ${h.freq}d</div>
      </div>
      <span class="h-restore" onclick="restoreCalc(${h.id})">Restaurar →</span>
    </div>`).join('');
}

function restoreCalc(id) {
  alert('Para restaurar un cálculo, recarga los datos manualmente en cada pantalla. (Función completa en v2)');
}

// ══════════════════════════════════════════════════════
// SHARE
// ══════════════════════════════════════════════════════
function showShare() {
  const r = state.results;
  const fmtN = (n, d=2) => (n === undefined || isNaN(n)) ? 'N/A' : n.toFixed(d);
  const crop = document.getElementById('crop_name').value || 'N/A';
  const parcel = document.getElementById('parcel_id').value || 'N/A';
  const date = document.getElementById('calc_date').value || 'N/A';

  const txt = `
╔══════════════════════════════════════╗
║     RECETA DE RIEGO — AgroRiego      ║
╚══════════════════════════════════════╝

Parcela: ${parcel}
Cultivo: ${crop} (etapa ${state.selectedStage})
Fecha:   ${date}

──────────────────────────────────────
RECOMENDACIÓN
──────────────────────────────────────
Lámina bruta a aplicar:  ${fmtN(r.gir)} mm/d
Volumen total:           ${fmtN(r.volGir)} m³
Tiempo total riego:      ${fmtN(r.timeTot)} h
Tiempo por sector:       ${fmtN(r.timeSec)} h
Frecuencia sugerida:     cada ${fmtN(r.freq,1)} días

──────────────────────────────────────
PARÁMETROS CALCULADOS
──────────────────────────────────────
ETc = ${fmtN(r.etc)} mm/d   (Kc=${r.kc} × ET₀=${fmtN(r.eto)} mm/d)
NIR = ${fmtN(r.nir)} mm/d   (max(0, ETc − Pe=${fmtN(r.pe)}))
GIR = ${fmtN(r.gir)} mm/d   (NIR / Ea=${r.ea})
TAW = ${fmtN(r.taw,1)} mm
RAW = ${fmtN(r.raw,1)} mm

──────────────────────────────────────
Generado con AgroRiego MVP v1.0
`.trim();

  document.getElementById('share_text').value = txt;
  document.getElementById('shareBox').classList.add('open');
}

function closeShare() { document.getElementById('shareBox').classList.remove('open'); }

function copyShare() {
  const el = document.getElementById('share_text');
  el.select();
  document.execCommand('copy');
  alert('✅ Copiado al portapapeles');
}

