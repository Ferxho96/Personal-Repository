function renderCatalogs() {
  // Crops
  document.getElementById('cat_crops_body').innerHTML = Object.entries(CROPS).map(([name, d]) => `
    <tr onclick="pickCropFromCatalog('${name}')">
      <td>${name}</td>
      <td class="num">${d.ini ?? '—'}</td>
      <td class="num">${d.des ?? '—'}</td>
      <td class="num">${d.med}</td>
      <td class="num">${d.fin ?? '—'}</td>
      <td class="num">${d.zr}</td>
      <td class="num">${d.p}</td>
    </tr>`).join('');

  // Soils
  document.getElementById('cat_soils_body').innerHTML = Object.entries(SOILS).map(([name, d]) => `
    <tr>
      <td>${name}</td>
      <td class="num">${d.taw}</td>
      <td class="num">${d.tfc}</td>
      <td class="num">${d.twp}</td>
    </tr>`).join('');

  // Methods
  document.getElementById('cat_methods_body').innerHTML = Object.entries(METHODS).map(([key, d]) => `
    <tr>
      <td>${d.name}</td>
      <td class="num">${d.ea}</td>
      <td class="num">${d.range}</td>
    </tr>`).join('');
}

function pickCropFromCatalog(name) {
  document.getElementById('crop_name').value = name;
  loadCropDefaults();
  showScreen('cultivo');
}
