plot_freq_percent <- function(data, vars, titulo, ncol = 2){
  df <- data %>%
    select(all_of(vars)) %>%
    pivot_longer(cols = everything(), names_to = "variable", values_to = "categoria") %>%
    mutate(
      categoria = as.factor(categoria),
      variable  = str_replace_all(variable, "_", " ")
    ) %>%
    group_by(variable, categoria) %>%
    summarise(n = n(), .groups = "drop") %>%
    group_by(variable) %>%
    mutate(pct = n / sum(n)) %>%
    ungroup()
  
  ggplot(df, aes(x = categoria, y = pct)) +
    geom_col() +
    geom_text(aes(label = percent(pct, accuracy = 0.1)), vjust = -0.2, size = 3) +
    scale_y_continuous(labels = percent_format(accuracy = 1), limits = c(0, 1.05)) +
    labs(
      title = titulo,
      x = NULL,
      y = "Porcentaje (%)"
    ) +
    facet_wrap(~variable, scales = "free_x", ncol = ncol) +
    theme_minimal() +
    theme(axis.text.x = element_text(angle = 0, hjust = 0.5))
}

