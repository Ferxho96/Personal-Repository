## correlaciones por grupos

cor_auto <- function(base, var_x, var_y){
  
  df <- base %>%
    dplyr::select(dplyr::all_of(c(var_x, var_y))) %>%
    tidyr::drop_na()
  
  colnames(df) <- c("x", "y")
  
  # Verificar que sean numéricas
  if (!is.numeric(df$x) | !is.numeric(df$y)) {
    return(data.frame(
      var_x     = var_x,
      var_y     = var_y,
      n         = nrow(df),
      metodo    = "No aplica (variable no numérica)",
      r         = NA,
      p_value   = NA,
      shapiro_x = NA,
      shapiro_y = NA
    ))
  }
  
  # Tamaño mínimo
  if (nrow(df) < 3) {
    return(data.frame(
      var_x     = var_x,
      var_y     = var_y,
      n         = nrow(df),
      metodo    = "No aplica (n<3)",
      r         = NA,
      p_value   = NA,
      shapiro_x = NA,
      shapiro_y = NA
    ))
  }
  
  # Normalidad (Shapiro)
  p_shap_x <- shapiro.test(df$x)$p.value
  p_shap_y <- shapiro.test(df$y)$p.value
  
  normal_x <- p_shap_x > 0.05
  normal_y <- p_shap_y > 0.05
  
  if (normal_x && normal_y) {
    metodo <- "Pearson"
    test   <- cor.test(df$x, df$y, method = "pearson")
  } else {
    metodo <- "Spearman"
    test   <- cor.test(df$x, df$y, method = "spearman")
  }
  
  data.frame(
    var_x     = var_x,
    var_y     = var_y,
    n         = nrow(df),
    metodo    = metodo,
    r         = unname(test$estimate),
    p_value   = test$p.value,
    shapiro_x = p_shap_x,
    shapiro_y = p_shap_y
  )
}

cor_auto_por_grupo <- function(base, outcome, vars_cont, grupo_var){
  
  grupos <- unique(base[[grupo_var]])
  resultados <- list()
  
  for (g in grupos) {
    
    sub <- base[base[[grupo_var]] == g, ]
    
    for (v in vars_cont) {
      res <- cor_auto(sub, outcome, v)
      res$grupo_var   <- grupo_var
      res$grupo_valor <- as.character(g)
      resultados[[length(resultados) + 1]] <- res
    }
  }
  
  do.call(rbind, resultados)
}

