# Nomalidad 

comparar_cohb <- function(var_grupo, base, outcome = "cohb_mean") {
  
  # Filtrar filas sin NA en variable de grupo o en COHb
  df <- base %>%
    select(all_of(c(var_grupo, outcome))) %>%
    drop_na()
  
  g <- df[[var_grupo]]
  x <- df[[outcome]]
  
  n_grupos <- length(unique(g))
  
  # Si hay menos de 2 grupos, no se puede comparar
  if (n_grupos < 2) {
    return(tibble(
      variable      = var_grupo,
      n_grupos      = n_grupos,
      test_usado    = "No aplica (solo un grupo)",
      p_valor       = NA_real_,
      shapiro_ok    = NA,
      levene_ok     = NA
    ))
  }
  
  # --- Normalidad por grupos (Shapiro) ---
  p_shapiro <- tapply(x, g, function(v){
    v <- v[!is.na(v)]
    if (length(v) < 3) return(NA_real_)   # Shapiro requiere n>=3
    shapiro.test(v)$p.value
  })
  
  shapiro_ok <- all(p_shapiro[!is.na(p_shapiro)] > 0.05)
  
  # --- Homogeneidad de varianzas (Levene) ---
  lev <- leveneTest(x ~ g)
  p_lev <- lev[1, "Pr(>F)"]
  levene_ok <- p_lev > 0.05
  
  # --- Elegir prueba según número de grupos y supuestos ---
  if (n_grupos == 2) {
    if (shapiro_ok && levene_ok) {
      test <- "t de Student (indep., var iguales)"
      p    <- t.test(x ~ g, var.equal = TRUE)$p.value
    } else {
      test <- "Mann-Whitney (Wilcoxon rank-sum)"
      p    <- wilcox.test(x ~ g)$p.value
    }
    
  } else { # 3 o más grupos
    if (shapiro_ok && levene_ok) {
      test <- "ANOVA una vía"
      p    <- summary(aov(x ~ g))[[1]][["Pr(>F)"]][1]
    } else {
      test <- "Kruskal-Wallis"
      p    <- kruskal.test(x ~ g)$p.value
    }
  }
  
  tibble(
    variable      = var_grupo,
    n_grupos      = n_grupos,
    test_usado    = test,
    p_valor       = p,
    shapiro_ok    = shapiro_ok,
    levene_ok     = levene_ok
  )
}

