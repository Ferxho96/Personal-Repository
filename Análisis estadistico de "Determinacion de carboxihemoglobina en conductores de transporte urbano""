#Correlacion

cor_auto <- function(base, var_x, var_y){
  
  x <- base[[var_x]]
  y <- base[[var_y]]
  
  # Quitar NA
  df <- na.omit(data.frame(x = x, y = y))
  
  # Tamaño mínimo
  if(nrow(df) < 3){
    return(data.frame(
      var_x = var_x,
      var_y = var_y,
      n = nrow(df),
      metodo = "No aplica (n<3)",
      r = NA,
      p_value = NA,
      shapiro_x = NA,
      shapiro_y = NA
    ))
  }
  
  # Normalidad (Shapiro)
  p_shap_x <- shapiro.test(df$x)$p.value
  p_shap_y <- shapiro.test(df$y)$p.value
  
  normal_x <- p_shap_x > 0.05
  normal_y <- p_shap_y > 0.05
  
  if(normal_x && normal_y){
    metodo <- "Pearson"
    test <- cor.test(df$x, df$y, method = "pearson")
  } else {
    metodo <- "Spearman"
    test <- cor.test(df$x, df$y, method = "spearman")
  }
  
  data.frame(
    var_x = var_x,
    var_y = var_y,
    n = nrow(df),
    metodo = metodo,
    r = unname(test$estimate),
    p_value = test$p.value,
    shapiro_x = p_shap_x,
    shapiro_y = p_shap_y
  )
}

