plot_categorica <- function(data, var, label_var){
  df <- data %>%
    count(.data[[var]], name = "n") %>%
    mutate(
      pct = n / sum(n),
      categoria = as.character(.data[[var]])
    ) %>%
    arrange(desc(n))
  
  ggplot(df, aes(x = reorder(categoria, -pct), y = pct)) +
    geom_col() +
    geom_text(aes(label = paste0("n=", n, " (", percent(pct, accuracy = 0.1), ")")),
              vjust = -0.25, size = 3) +
    scale_y_continuous(labels = percent_format(accuracy = 1), limits = c(0, 1.10)) +
    labs(
      title = label_var,
      x = NULL,
      y = "Porcentaje (%)"
    ) +
    theme_minimal() +
    theme(axis.text.x = element_text(angle = 15, hjust = 1))
}

