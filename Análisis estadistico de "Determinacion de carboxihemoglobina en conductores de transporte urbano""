prueba_asociacion <- function(var_exp, var_resp, datos){
  # Tabla de contingencia sin NAs
  tab <- table(datos[[var_exp]], datos[[var_resp]], useNA = "no")
  
  # Si alguna de las variables solo tiene una categoría observable
  if (nrow(tab) < 2 | ncol(tab) < 2) {
    metodo <- "No aplica (una sola categoría)"
    p_val  <- NA
  } else {
    # Si hay celdas en cero, preferimos Fisher
    if (any(tab == 0)) {
      metodo <- "Fisher (celdas con 0)"
      p_val  <- fisher.test(tab)$p.value
    } else {
      chi <- chisq.test(tab)
      if (any(chi$expected < 5)) {
        metodo <- "Fisher (esperados < 5)"
        p_val  <- fisher.test(tab)$p.value
      } else {
        metodo <- "Chi-cuadrado"
        p_val  <- chi$p.value
      }
    }
  }
  
  data.frame(
    Variable_explicativa = var_exp,
    Sintoma              = var_resp,
    Metodo               = metodo,
    p_value              = p_val
  )
}

